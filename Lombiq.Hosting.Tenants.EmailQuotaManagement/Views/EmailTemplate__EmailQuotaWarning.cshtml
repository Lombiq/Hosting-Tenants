@{
    ViewLayout = "Layout__EmailTemplate";
}

@T["<p>Hi,</p><p>It seems that your site '{0}' sent out {1}% of the available e-mail quota for this month. " +
    "E-mail sending will be stopped and any feature sending out e-mails will fail until next month, when the quota " +
    "is exceeded.</p><p>Thank you,<br/>Your Admin Crew</p>",
    Model.HostName,
    Model.Percentage]
