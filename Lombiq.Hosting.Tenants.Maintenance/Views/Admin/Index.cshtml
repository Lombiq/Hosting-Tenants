@using Lombiq.Hosting.Tenants.Maintenance.Constants
@using Lombiq.Hosting.Tenants.Maintenance.Controllers
@using OrchardCore.Mvc.Core.Utilities
@model OrchardCore.ContentManagement.ContentItem

<zone Name="Title"><h1>@RenderTitleSegments(T["Staggered Maintenance"])</h1></zone>
<div class="d-flex align-items-center gap-3 mb-3">
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" id="autoRefreshToggle">
        <label class="form-check-label" for="autoRefreshToggle">@T["Auto Refresh"]</label>
    </div>

    <div>
        <label for="refreshRateSelect" class="form-label mb-0">@T["Refresh Rate"]</label>
        <select class="form-select form-select-sm d-inline w-auto" id="refreshRateSelect">
            <option value="5000">@T["5s"]</option>
            <option value="10000" selected>@T["10s"]</option>
            <option value="15000">@T["15s"]</option>
            <option value="30000">@T["30s"]</option>
        </select>
    </div>
    <div id="refreshCountdown" class="text-muted small mt-1"></div>
</div>

<div id="maintenance-status-container">
    @await Html.PartialAsync("StaggeredMaintenanceDetails", Model)
</div>

<style at="Head">
    #maintenance-progress-bar {
        transition: width 1s ease;
    }
</style>

<script at="Foot">
    let pollingInterval = null;
    let countdownTimer = null;
    let pollingRate = 10000;
    let countdown = pollingRate / 1000;

    // === Core Polling ===
    function startPolling() {
        stopPolling();

        pollNow();

        pollingInterval = setInterval(() => {
            pollNow();
            countdown = pollingRate / 1000;
        }, pollingRate);

        startCountdown();
    }

    function stopPolling() {
        if (pollingInterval !== null) {
            clearInterval(pollingInterval);
            pollingInterval = null;
        }

        if (countdownTimer !== null) {
            clearInterval(countdownTimer);
            countdownTimer = null;
        }

        updateCountdownDisplay(true);
    }

    function pollNow() {
        if (document.hidden) return;

        fetch('@Url.Action(nameof(AdminController.GetPartialView), typeof(AdminController).ControllerName(), new { area = FeatureNames.Maintenance })')
            .then(response => response.text())
            .then(updateMaintenanceContent);
    }

    function updateMaintenanceContent(html) {
        const container = document.getElementById('maintenance-status-container');
        const oldBar = document.getElementById('maintenance-progress-bar');
        const oldWidth = oldBar?.style.width;
        const oldNumber = oldBar ? parseInt(oldBar.textContent) : 0;

        container.innerHTML = html;

        const newBar = document.getElementById('maintenance-progress-bar');
        if (newBar && oldWidth) {
            newBar.style.width = oldWidth;
            void newBar.offsetWidth;
            newBar.style.width = newBar.getAttribute('aria-valuenow') + '%';
        }

        const newPercentage = parseInt(newBar?.getAttribute('aria-valuenow') || "0");
        if (newBar) animateNumber(newBar, oldNumber, newPercentage);

        const isRunning = container.querySelector('[data-maintenance-running]')?.dataset.maintenanceRunning === 'true';
        if (!isRunning) stopPolling();

        // Re-initialize popovers
        document.querySelectorAll('[data-bs-toggle="popover"]').forEach(el => new bootstrap.Popover(el));
    }

    // === Countdown ===
    function startCountdown() {
        countdown = pollingRate / 1000;
        updateCountdownDisplay();

        countdownTimer = setInterval(() => {
            countdown--;
            updateCountdownDisplay();
        }, 1000);
    }

    function updateCountdownDisplay(clear = false) {
        const el = document.getElementById('refreshCountdown');
        if (!el) return;

        el.textContent = clear ? '' : `Next refresh in ${countdown}s`;
    }

    // === Animation ===
    function animateNumber(element, start, target) {
        const duration = 800;
        const startTime = performance.now();

        function step(currentTime) {
            const progress = Math.min((currentTime - startTime) / duration, 1);
            const value = Math.floor(progress * (target - start) + start);
            element.textContent = value + ' %';
            if (progress < 1) requestAnimationFrame(step);
        }

        requestAnimationFrame(step);
    }

    // === Init ===
    const toggle = document.getElementById('autoRefreshToggle');
    const rateSelect = document.getElementById('refreshRateSelect');

    const savedToggle = localStorage.getItem('autoRefreshEnabled');
    const savedRate = localStorage.getItem('autoRefreshRate');

    if (savedToggle !== null) toggle.checked = savedToggle === 'true';
    if (savedRate !== null) {
        rateSelect.value = savedRate;
        pollingRate = parseInt(savedRate);
    }

    if (toggle.checked) startPolling();

    toggle.addEventListener('change', () => {
        localStorage.setItem('autoRefreshEnabled', toggle.checked);
        toggle.checked ? startPolling() : stopPolling();
    });

    rateSelect.addEventListener('change', () => {
        pollingRate = parseInt(rateSelect.value);
        localStorage.setItem('autoRefreshRate', pollingRate);
        if (toggle.checked) startPolling();
    });

    // === Tab visibility handler ===
    document.addEventListener('visibilitychange', () => {
        if (!document.hidden && toggle.checked) {
            startPolling();
        }
    });
</script>
